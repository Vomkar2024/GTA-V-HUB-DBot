# Required: create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# Optional command sync target (guild sync updates faster than global sync)
GUILD_ID=
# Clear global commands on startup when GUILD_ID is set (fixes duplicate commands in server)
CLEAR_GLOBAL_ON_STARTUP=false
# Enable legacy/starter commands (/cars, /jobs, /garage, /daily, etc.)
ENABLE_LEGACY_COMMANDS=true
# Comma-separated Discord user IDs allowed to use /hubadmin
OWNER_IDS=

# Restrict bot commands to a specific Discord channel (channel ID)
# Default focus channel: 1567917854341472387
ALLOWED_CHANNEL_ID=1567917854341472387

# Optional links shown in /invite and /support
INVITE_URL=
SUPPORT_URL=
DONATE_URL=

# Local data and persistence
DATA_DIR=data
DATABASE_PATH=data/gtavhub.sqlite3

# Optional integrations (must return the JSON shapes described in README)
GTA_HUB_WEATHER_API_URL=
GTA_HUB_SYNC_API_URL=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
